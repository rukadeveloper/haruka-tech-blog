# 관리자로 허용할 GitHub 계정 (기본값 rukadeveloper)
ADMIN_GITHUB_LOGIN=rukadeveloper
# 로그인 쿠키 서명용 비밀 값 (긴 랜덤 문자열)
SESSION_SECRET=long-random-string

# GitHub OAuth (댓글 로그인) — https://github.com/settings/developers 에서 OAuth App 생성
# Callback URL: http://localhost:3000/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Supabase (글·댓글·카테고리 저장) — Project Settings > API
# service role 키는 RLS 를 우회하는 서버 전용 비밀 키. NEXT_PUBLIC_ 을 붙이지 말고 커밋하지 말 것
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# 이미지 저장 (S3)
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=

# 화면 밖(스크립트·Supabase 대시보드)에서 글을 바꾼 뒤 캐시를 바로 비우는 /api/revalidate 용 (선택, 없으면 비활성화)
# 호출: curl -X POST -H "Authorization: Bearer <값>" https://내도메인/api/revalidate
REVALIDATE_SECRET=
